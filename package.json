{
  "name": "aero-allocator",
  "version": "0.1.0",
  "description": "Aerodrome Predictive Allocation optimizer — MCP server that forecasts next-epoch pool demand on Base and recommends incentive allocations",
  "type": "module",
  "bin": {
    "aero-allocator": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    "./scoring": "./dist/scoring.js",
    "./data": "./dist/data.js",
    "./config": "./dist/config.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "aerodrome",
    "base",
    "mcp",
    "defi",
    "predictive-allocation",
    "veaero"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
